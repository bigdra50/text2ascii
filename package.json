{
  "name": "text2ascii",
  "version": "0.1.0",
  "description": "Turn a theme into ASCII art, with Claude deciding what to draw",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "text2ascii": "src/cli/main.ts",
    "t2a": "src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun src/cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun build src/cli/main.ts --compile --outfile dist/text2ascii"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  }
}
